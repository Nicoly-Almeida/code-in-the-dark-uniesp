# Exemplo de variáveis da Edge Function `submit`. NÃO coloque valores reais aqui.
#
# Uso local:   cp .env.example supabase/functions/.env
#              supabase functions serve submit --env-file supabase/functions/.env
# Produção:    supabase secrets set ALLOWED_ORIGINS=https://nicoly-almeida.github.io
#              (ou Dashboard > Edge Functions > Secrets)
#
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY são injetadas automaticamente pelo
# Supabase nas Edge Functions. Não crie essas variáveis no site nem no Git.

# Origens exatas aceitas pelo CORS, separadas por vírgula (sem barra no fim).
ALLOWED_ORIGINS=https://SEU-USUARIO.github.io

# Teto global do código em bytes (cada rodada também tem seu próprio limite).
MAX_CODE_BYTES=200000
